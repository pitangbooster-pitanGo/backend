{
  "name": "temp-strapi",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "seed:demo": "npm run build && npm run seed:demo:base && npm run seed:demo:tracks:institutional && npm run seed:demo:tracks:projects && npm run seed:demo:assignments:a && npm run seed:demo:assignments:b",
    "seed:demo:base": "node scripts/seed-demo.js --stage=base",
    "seed:demo:tracks:institutional": "node scripts/seed-demo.js --stage=tracks-institutional",
    "seed:demo:tracks:projects": "node scripts/seed-demo.js --stage=tracks-projects",
    "seed:demo:assignments:a": "node scripts/seed-demo.js --stage=assignments-a",
    "seed:demo:assignments:b": "node scripts/seed-demo.js --stage=assignments-b",
    "validate:e2e": "node scripts/validate-e2e.mjs",
    "validate:evidences": "node scripts/validate-evidences.mjs",
    "validate:encontro7": "node scripts/validate-encontro-7.mjs",
    "validate:encontro6": "node scripts/validate-encontro-6.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "develop:test": "dotenv -e .env.test -- strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@strapi/plugin-cloud": "5.40.0",
